# ============================================================
# TrendBot — Environment Configuration Example
# Copy this file to .env and fill in your values.
# ============================================================

# ----------------------------------------------------------
# BROKER SELECTION
# "paper"  → built-in simulation (no API keys required)
# "alpaca" → Alpaca paper trading account (free at alpaca.markets)
# ----------------------------------------------------------
BROKER=paper

# ----------------------------------------------------------
# ALPACA PAPER TRADING  (only required when BROKER=alpaca)
# Sign up free at: https://alpaca.markets
# Dashboard → Paper Trading → API Keys
# ----------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ----------------------------------------------------------
# STRATEGY PARAMETERS
# DO NOT change these after running your first backtest.
# Changing them invalidates out-of-sample results.
# ----------------------------------------------------------
INITIAL_CAPITAL=100000
RISK_PER_TRADE=0.005
MAX_POSITIONS=4
MAX_POSITION_PCT=0.25
ENTRY_LOOKBACK=100
EXIT_LOOKBACK=50
SMA_LENGTH=200
ATR_LENGTH=20
ATR_MULTIPLIER=2.0

# ----------------------------------------------------------
# INSTRUMENTS (comma-separated ETF symbols)
# ----------------------------------------------------------
SYMBOLS=SPY,QQQ,IWM,EFA,EEM,TLT,GLD,DBC,VNQ,UUP

# ----------------------------------------------------------
# SCHEDULER (cron expression, UTC timezone)
# Default: 10:30 PM UTC Mon-Fri (after NYSE close + data delay)
# ----------------------------------------------------------
SCHEDULE_CRON=30 22 * * 1-5

# ----------------------------------------------------------
# DATABASE
# Default: SQLite file in project root
# ----------------------------------------------------------
DATABASE_URL=sqlite:///./trendbot.db

# ----------------------------------------------------------
# SERVER
# ----------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ----------------------------------------------------------
# DATA HISTORY
# How far back to download for backtest seeding
# ----------------------------------------------------------
DATA_PERIOD=15y

# ----------------------------------------------------------
# LOGGING
# DEBUG, INFO, WARNING, ERROR
# ----------------------------------------------------------
LOG_LEVEL=INFO
